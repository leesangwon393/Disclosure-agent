# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 있으니 절대 커밋되지 않는다. 키를 이 파일에 적지 말 것.

# ── 필수 ────────────────────────────────────────────────────────────────
# HyperCLOVA X API 키. 발급받은 값을 넣는다.
HCX_API_KEY=
# 사용할 모델. 대회 제출은 HCX-007 기준으로 맞춰져 있다.
HCX_MODEL=HCX-007

# ── 선택: 아래는 전부 기본값이 있어서 비워둬도 돌아간다 ──────────────────
# 산출물 경로. 현행 빌드는 artifacts_v2 다.
#   서빙(serving/api.py)과 측정 스크립트 모두 이 값이 기본이라 보통은 안 건드려도 된다.
#   구버전 빌드로 돌려보고 싶을 때만 ARTIFACTS=artifacts 로 바꾼다.
ARTIFACTS=artifacts_v2

# 원본 공시 코퍼스 경로 (corpus/raw 는 대회 데이터로 가는 심볼릭 링크)
# CORPUS_ROOT=corpus

# 파이프라인 선택. v2 = 규칙 기반 신 파이프라인(현행), v1 = 구 경로
# PIPELINE=v2

# HCX 리즈닝(thinking) 정책. off | auto | on — 기본 off
# THINKING=off

# 크로스 인코더 리랭커 사용 여부. 0 이면 끈다 (기본 켜짐)
# USE_RERANKER=1

# 밀집 검색 백엔드. numpy(기본, 정확 탐색) | qdrant
# DENSE_BACKEND=numpy

# 연산 장치. 비우면 자동 판별 (cuda / mps / cpu)
# DISCLOSURE_DEVICE=

# 문항당 소프트 제한시간(초)
# ANSWER_BUDGET_SEC=240

# 디버그용: LLM 호출 없이 검색 결과만 본다
# NO_LLM=0

# 구 도구호출 에이전트 경로를 쓸 때만 1 (PIPELINE=v2 면 무시된다)
# USE_AGENT=0

# 밀집 인덱스를 강제로 다시 만든다 (평소엔 비워둔다)
# REINDEX_DENSE=
